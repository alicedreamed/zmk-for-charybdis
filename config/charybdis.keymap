#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&mt { flavor = "tap-preferred"; };

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 0>;
        };

        To1_macro_A: To1_macro_A {
            compatible = "zmk,behavior-macro";
            label = "To1_macro_A";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(128,100,50) &to 0>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro_A: To2_macro_A {
            compatible = "zmk,behavior-macro";
            label = "To2_macro_A";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(250,100,50) &to 2>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(250,100,50) &to 2>;
        };

        To3_macro: To_3 {
            compatible = "zmk,behavior-macro";
            label = "TO_3";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(360,100,46) &to 3>;
        };
    };

    behaviors {
        th1_space: th1_space {
            compatible = "zmk,behavior-hold-tap";
            label = "TH1_SPACE";
            bindings = <&To1_macro>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
        };

        th2_cmdspace: th2_cmdspace {
            compatible = "zmk,behavior-hold-tap";
            label = "TH2_CMDSPACE";
            bindings = <&none>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Main {
            bindings = <
&kp TAB    &kp Q        &kp W           &kp E             &kp R         &kp T                     &kp Y                        &kp U            &kp I              &kp O           &kp P                        &kp GRAVE
&kp ESC    &mt LCTRL A  &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt LCMD F    &mt LS(LA(LC(LGUI))) G    &mt LS(LC(LA(RIGHT_GUI))) H  &mt RIGHT_GUI J  &mt RIGHT_SHIFT K  &mt LEFT_ALT L  &mt RIGHT_CONTROL SEMICOLON  &kp APOS
&kp LSHFT  &kp Z        &kp X           &kp C             &kp V         &kp B                     &kp N                        &kp M            &kp COMMA          &kp DOT         &kp FSLH                     &kp BSLH
                        &kp MINUS       &kp EQUAL         &kp LEFT_GUI  &lt 1 SPACE               &kp ENTER                    &kp BACKSPACE    &kp LBKT           &kp RBKT
                        &trans          &lt 2 LG(SPACE)   &trans        &trans                    &trans                       &mo 2            &lt 2 LS(ENTER)    &mo 3
            >;
        };

        num {
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH   &kp DOLLAR        &kp PERCENT          &kp CARET       &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL
&trans  &kp N1           &kp N2       &kp N3     &kp N4            &kp N5               &kp N6          &kp N7           &kp N8        &kp N9                &kp N0                 &kp MINUS
&trans  &trans           &kp TILDE    &kp GRAVE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET    &kp LEFT_BRACE  &kp RIGHT_BRACE  &trans        &trans                &trans                 &trans
                         &trans       &trans     &trans            &trans               &trans          &trans           &trans        &trans
                         &trans       &trans     &trans            &trans               &trans          &trans           &trans        &trans
            >;
        };

        media {
            bindings = <
&trans  &trans  &trans          &kp UP_ARROW    &trans     &kp LS(LA(C_VOLUME_UP))      &trans    &trans          &trans        &trans     &trans  &trans
&trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &kp LS(LA(C_VOLUME_DOWN))    &kp LEFT  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &trans  &trans
&trans  &trans  &trans          &trans          &trans     &kp K_MUTE                   &trans    &trans          &trans        &trans     &trans  &trans
                &trans          &trans          &trans     &trans                       &trans    &trans          &trans        &trans
                &trans          &trans          &trans     &trans                       &trans    &trans          &trans        &trans
            >;
        };

        keyboard {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &none    &none
&kp F1      &kp F2        &kp F3        &kp F4        &kp F5        &kp F6          &kp F7           &kp F8           &kp F9           &kp F10          &kp F11  &kp F12
&none       &none         &none         &none         &none         &none           &none            &none            &none            &none            &none    &none
                          &none         &bootloader   &none         &none           &none            &none            &bootloader      &none
                          &none         &none         &none         &none           &none            &none            &none            &none
            >;
        };
    };
};
